{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: add + commit + push",
      "type": "shell",
      "command": "git add . && git commit -m \"${input:commitMessage}\" && git push",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Git: push",
      "type": "shell",
      "command": "git push",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Сообщение коммита",
      "default": "update"
    }
  ]
}
